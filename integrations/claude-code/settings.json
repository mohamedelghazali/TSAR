{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "TSAR_CLAUDE_DOMAINS": "development,agentic_ai,ai_security,secrets",
    "TSAR_CLAUDE_SCOPES": "repo:read,repo:write"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-m", "claude_code_hook"],
            "timeout": 180,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-m", "claude_code_hook"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-m", "claude_code_hook"],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-m", "claude_code_hook"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
