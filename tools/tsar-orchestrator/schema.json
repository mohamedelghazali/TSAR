{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TSAR Orchestrator Report",
  "type": "object",
  "required": ["started_at", "finished_at", "duration", "summary", "steps"],
  "properties": {
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration": {"type": "number", "minimum": 0},
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed", "skipped", "max_duration_s"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "max_duration_s": {"type": "number", "minimum": 0}
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "exit_code", "duration", "skipped"],
        "properties": {
          "name": {"type": "string"},
          "exit_code": {"type": "integer"},
          "duration": {"type": "number", "minimum": 0},
          "skipped": {"type": "boolean"},
          "stdout": {"type": "string"},
          "stderr": {"type": "string"}
        }
      }
    }
  }
}
